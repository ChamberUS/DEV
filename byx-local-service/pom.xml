<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>byx</groupId>
  <artifactId>byx-local-service</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>BYX local service (V2.1A foundation)</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- perfil da chain do ARTEFATO (PRODUCTION_DISABLED | LOCAL_QA); só muda no build: -Dbyx.chain.profile=LOCAL_QA (via build-app.sh, opção chain-profile local-qa) -->
    <byx.chain.profile>PRODUCTION_DISABLED</byx.chain.profile>
  </properties>
  <dependencies>
    <!-- única dependência de runtime: parser JSON estrito (a mesma versão que o painel já usa) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.20.0</version>
    </dependency>
    <!-- identidade do peer no macOS (getsockopt + Security.framework); mesma versão do painel -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.17.0</version>
    </dependency>
    <!-- Argon2id (mesma versão e mesmos parâmetros auditados do painel) -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- Prevent retired transport bytecode from an incremental target directory entering any runtime artifact. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.1</version>
        <configuration><excludes>
          <exclude>byx/service/signer/SignerClient*.class</exclude>
          <exclude>byx/service/auth/AuthQaMain*.class</exclude>
          <exclude>byx/service/migration/MigrateQaMain*.class</exclude>
          <exclude>byx/service/migration/LegacyPanelHash*.class</exclude>
          <exclude>byx/service/secrets/SecretCanary*.class</exclude>
        </excludes></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables><byx.chain.profile.expected>${byx.chain.profile}</byx.chain.profile.expected></systemPropertyVariables>
          <!-- só os testes de identidade do peer precisam ler o fd do socket; o lançador empacotado define os mesmos flags -->
          <argLine>--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
