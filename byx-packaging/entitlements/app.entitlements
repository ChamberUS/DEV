<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ÚNICO entitlement: a JVM (HotSpot) reserva o code cache com MAP_JIT; sem isto ela nem inicia sob Hardened Runtime
         ("Could not reserve enough space for code cache", provado em 2026-10-06). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
