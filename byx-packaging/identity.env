# Identidade do produto (fonte única para o empacotamento; o código tem as mesmas constantes e um teste confere as duas).
# PROPOSTA: o projeto não tinha namespace formal de bundle. "network.byx" reflete o nome do produto; troque por um domínio realmente
# controlado antes de qualquer distribuição externa (mudar aqui + nas constantes de AppIdentity e no teste de paridade).
BYX_APP_ID=network.byx.mvp
BYX_SERVICE_ID=network.byx.mvp.service
BYX_APP_NAME=BYX-MVP
# O CFBundleVersion do macOS não aceita 0.x; 1.0.0 é a versão do pacote. Componentes: painel 0.1.0, serviço 0.1.0.
BYX_BUNDLE_VERSION=1.0.0
