# Identidade do produto (fonte única para o empacotamento; o código tem as mesmas constantes e um teste confere as duas).
# DEFINITIVO (decisão do projeto, 2026-10-06): reverse-DNS do domínio buynnex.com, controlado pelo projeto. Não voltar aos IDs provisórios.
# Para trocar de novo: ./set-final-ids.sh <app-id> <service-id> --apply (um só passo).
BYX_APP_ID=com.buynnex.byx
BYX_SERVICE_ID=com.buynnex.byx.service
# true = IDs definitivos: itens permanentes, perfil de provisionamento e grupo de acesso podem ser criados sob estes IDs (set-final-ids.sh liga a flag).
BYX_IDS_FINAL=true
BYX_APP_NAME=BYX-MVP
# O CFBundleVersion do macOS não aceita 0.x; 1.0.0 é a versão do pacote. Componentes: painel 0.1.0, serviço 0.1.0.
BYX_BUNDLE_VERSION=1.0.0
