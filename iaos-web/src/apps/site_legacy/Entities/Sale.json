{
  "name": "Sale",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja"
    },
    "store_name": {
      "type": "string",
      "description": "Nome da loja"
    },
    "seller_email": {
      "type": "string",
      "description": "Email do vendedor"
    },
    "amount_brl": {
      "type": "number",
      "description": "Valor da venda em R$"
    },
    "cashback_aios": {
      "type": "number",
      "description": "Cashback em AIOS oferecido"
    },
    "customer_email": {
      "type": "string",
      "description": "Email do cliente (opcional)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da venda"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "qr_code",
        "manual",
        "pos"
      ],
      "default": "manual"
    }
  },
  "required": [
    "store_id",
    "amount_brl"
  ]
}