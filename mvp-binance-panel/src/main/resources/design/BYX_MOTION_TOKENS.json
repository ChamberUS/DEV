    "REDUCED": {
      "durationScale": "see reducedMs fields",
      "translate": false,
      "scale": false,
      "loops": "spinner only",
      "note": "keep essential feedback (focus, color, opacity)"
    },
    "OFF": {
      "durationScale": 0,
      "translate": false,
      "scale": false,
      "loops": false,
      "note": "state changes are instant; spinner may show a static glyph"
    },
    "devOnlyControl": true
  },
